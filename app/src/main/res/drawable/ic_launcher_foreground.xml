<?xml version="1.0" encoding="utf-8"?>
<!--
  A head (a white circle outline) with a "pause" glyph centered inside it: "pause before
  you reach for an app". No body. The two pause bars glow outward: vector drawables can't
  blur, so the glow is faked with translucent strokes stacked under the solid white bars.
  The strokes step down in width by 1 unit at a time (7 -> 3) so their overlap reads as a
  smooth gradient rather than visible bands, and the widest is kept small for a tight halo.
  The head and bars are white, so the drawable also serves as the monochrome layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Head: clean thin ring. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:pathData="M24,54 a30,30 0 1 0 60,0 a30,30 0 1 0 -60,0 z" />
    <!-- Outward glow on the two pause bars: widest/faintest first, stepping inward. -->
    <path
        android:fillColor="#00000000" android:strokeColor="#0FFFFFFF" android:strokeWidth="7"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M46,40 h1 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z M61,40 h1 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#00000000" android:strokeColor="#17FFFFFF" android:strokeWidth="6"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M46,40 h1 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z M61,40 h1 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#00000000" android:strokeColor="#21FFFFFF" android:strokeWidth="5"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M46,40 h1 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z M61,40 h1 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#00000000" android:strokeColor="#33FFFFFF" android:strokeWidth="4"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M46,40 h1 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z M61,40 h1 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#00000000" android:strokeColor="#4DFFFFFF" android:strokeWidth="3"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M46,40 h1 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z M61,40 h1 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z" />
    <!-- Solid pause bars (core). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,40 h1 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z M61,40 h1 a3,3 0 0 1 3,3 v22 a3,3 0 0 1 -3,3 h-1 a3,3 0 0 1 -3,-3 v-22 a3,3 0 0 1 3,-3 z" />
    <!-- Three short "drip" lines under the left bar; the middle one is the longest. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M44,71 L44,75 M46.5,71 L46.5,77.5 M49,71 L49,75" />
</vector>
